{
  "name": "salvadorgym",
  "version": "1.0.0",
  "description": "Sistema POS de Escritorio para la administración de Salvador Gym",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --win --x64"
  },
  "keywords": [],
  "author": "VENDERPROYECTOWEB",
  "license": "ISC",
  "dependencies": {
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "asar": false,
    "appId": "com.salvadorgym.pos",
    "productName": "Salvador Gym",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icono.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Salvador Gym"
    },
    "files": [
      "src/**/*",
      "salvador.db",
      "package.json"
    ]
  }
}